  "panels": [
    {
      "title": "HTTP Request Rate by Replica (1m window)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "description": "HTTP request rate per application replica (A, B, C) scraped directly by Prometheus.",
      "targets": [
        {
          "expr": "sum by (replica) (rate(http_request_duration_seconds_count[1m]))",
          "legendFormat": "HTTP Replica {{replica}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "req/s" },
        "overrides": []
      }
    },
    {
      "title": "gRPC Request Rate by Replica (1m window)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "description": "gRPC call rate per service replica (A, B, C) scraped directly on metrics port 50052.",
      "targets": [
        {
          "expr": "sum by (replica) (rate(grpc_calls_total[1m]))",
          "legendFormat": "gRPC Replica {{replica}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "req/s" },
        "overrides": []
      }
    },
    {
      "title": "HTTP Traffic Share by Replica (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "description": "Percentage share of total HTTP traffic handled by each replica. Baseline expectation: Replica A = 100%, B/C = 0%.",
      "targets": [
        {
          "expr": "(sum by (replica) (rate(http_request_duration_seconds_count[1m])) / ignoring(replica) group_left sum(rate(http_request_duration_seconds_count[1m]))) * 100",
          "legendFormat": "HTTP Replica {{replica}} Share (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "gray", "value": null },
              { "color": "yellow", "value": 33.3 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "gRPC Traffic Share by Replica (%)",
